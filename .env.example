# JEJU LifePath AI environment template.
# Copy to `.env` locally. Never commit real keys, personal locations or GPS traces.
# G0 needs no external API. Keys below are placeholders for later gates.

# G1 데이터 확보 (공공데이터포털 / 제주데이터허브)
DATA_GO_KR_API_KEY=
JEJU_DATAHUB_API_KEY=

# G9 Agent LLM provider (unset = LLM features unavailable; routing still works)
LLM_API_KEY=

# 카카오맵 JavaScript 키 (Kakao Developers에서 웹 도메인 등록 필수)
KAKAO_JS_KEY=
