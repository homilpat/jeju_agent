# JEJU LifePath AI environment template.
# Copy to `.env` locally. Never commit real keys, personal locations or GPS traces.
# G0 needs no external API. Keys below are placeholders for later gates.

# G1 데이터 확보 (공공데이터포털 / 제주데이터허브)
# 공공데이터포털 일반 인증키(Decoding): 횡단보도 표준데이터 (제주 교통정보 API는 사업자등록증 필요해 보류)
DATA_GO_KR_API_KEY=
# 제주데이터허브 프로젝트키(마이페이지 > 프로젝트 관리): 493 사고다발지, 495 약국, 720 와이파이
JEJU_DATAHUB_API_KEY=
# 생활안전지도 인증키: 범죄주의구간
SAFEMAP_API_KEY=

# 카카오 디벨로퍼스: 화면 지도(JavaScript 키), 장소 검색(REST API 키)
KAKAO_JS_KEY=
KAKAO_REST_API_KEY=

# G9 Agent LLM provider (unset = LLM features unavailable; routing still works)
LLM_API_KEY=

# 제주데이터허브 데이터ID (허브 데이터 페이지 API 탭, proxy/ 바로 뒤 값)
JEJU_HUB_WIFI_DATA_ID=
JEJU_HUB_PHARMACY_DATA_ID=
JEJU_HUB_ACCIDENT_DATA_ID=
